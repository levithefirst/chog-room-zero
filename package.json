{
  "name": "chog-room-zero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.library.config.ts",
    "build:library": "vite build -c vite.library.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir",
    "server": "node dist-server/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "pixi.js": "^8.22.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
